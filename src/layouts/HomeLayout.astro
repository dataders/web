---
import SiteLayout from './SiteLayout.astro';

const { frontmatter, headings } = Astro.props;
const { title, description, intro, links, testimonial } = frontmatter;
const sections = headings.filter(({ depth }) => depth === 2);
---

<SiteLayout title={title} description={description}>
  <header id="top">
    <h1>{title}</h1>
    <p id="approach">{intro}</p>
    <nav class="links" id="connect" aria-label="Profiles and working guide">
      {links.map(({ label, url }) => <a href={url}>{label}</a>)}
    </nav>
    <nav class="links section-links" aria-label="Site navigation">
      {sections.map(({ slug, text }) => <a href={`#${slug}`}>{text}</a>)}
      <a href="/blog/">Blog</a>
    </nav>
  </header>

  <div class="home-content">
    <slot />
  </div>

  {testimonial && (
    <footer>
      <figure>
        <blockquote>{testimonial.quote}</blockquote>
        <figcaption>{testimonial.attribution} <a href={testimonial.url}>{testimonial.label}</a></figcaption>
      </figure>
    </footer>
  )}
</SiteLayout>
