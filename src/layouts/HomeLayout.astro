---
import SiteLayout from './SiteLayout.astro';

const { frontmatter, headings } = Astro.props;
const { title, description, intro, links, resume, testimonial } = frontmatter;
const sections = headings.filter(({ depth }) => depth === 2);
---

<SiteLayout title={title} description={description}>
  <header id="top">
    <h1>{title}</h1>
    <div id="approach">
      {intro.split(/\n[ \t]*\n/).map((paragraph: string) => <p>{paragraph}</p>)}
    </div>
    <nav class="links profile-links" id="connect" aria-label="Profile links and resources">
      {links.map(({ label, url, icon }) => (
        <a href={url}>
          {icon && <img src={icon} width="18" height="18" alt="" />}
          {label}
        </a>
      ))}
      {resume && <a href={resume} download="Anders-Swanson-Resume.pdf">Résumé (PDF)</a>}
    </nav>
    <nav class="links section-links" aria-label="Site navigation">
      {sections.map(({ slug, text }) => <a href={`#${slug}`}>{text}</a>)}
    </nav>
  </header>

  <div class="home-content">
    <slot />
  </div>

  {testimonial && (
    <footer>
      <figure>
        <blockquote>{testimonial.quote}</blockquote>
        <figcaption>{testimonial.attribution} <a href={testimonial.url}>{testimonial.label}</a></figcaption>
      </figure>
    </footer>
  )}
</SiteLayout>
