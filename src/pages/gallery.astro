---
import ImageGallery from '../components/ImageGallery.astro';
import SiteLayout from '../layouts/SiteLayout.astro';

const images = [
  { src: '/gallery/images/databricks-and-snowflake.png', width: 1358, height: 635, alt: 'Databricks and Snowflake sharing Iceberg tables through S3 and the Iceberg REST API' },
  { src: '/gallery/images/before-and-after-odi.png', width: 1874, height: 1085, alt: 'Comparison of data roles before and after open data infrastructure' },
  { src: '/gallery/images/agent-schema.png', width: 2450, height: 2278, alt: 'Whiteboard showing how project metadata becomes context for analytics agents' },
  { src: '/gallery/images/fusion-distribution.png', width: 1212, height: 922, alt: 'Fusion distribution diagram showing the parser, compiler, and execution layers' },
  { src: '/gallery/images/adapter-architecture.png', width: 1865, height: 1356, alt: 'Two approaches to connecting a database adapter and driver' },
  { src: '/gallery/images/core-vs-fusion.png', width: 1995, height: 1769, alt: 'Comparison of dbt Core and Fusion execution setups' },
  { src: '/gallery/images/capability-map.png', width: 2120, height: 1440, alt: 'Map connecting compiler capabilities, features, value propositions, and personas' },
  { src: '/gallery/images/metadata-commercialization.png', width: 1295, height: 968, alt: 'Whiteboard mapping dbt metadata primitives to user-facing capabilities' },
  { src: '/gallery/images/agent-infrastructure.png', width: 1580, height: 934, alt: 'Whiteboard showing agent infrastructure, capabilities, and examples' },
];
---

<SiteLayout title="Gallery · Anders Swanson" description="Diagrams and whiteboards by Anders Swanson.">
  <ImageGallery images={images} label="Gallery" />
</SiteLayout>
