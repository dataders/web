---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { formatPostDate, getPublishedPosts } from '../../lib/blog';

const posts = await getPublishedPosts();
---

<SiteLayout title="Blog · Anders Swanson" description="Posts by Anders Swanson.">
  <nav class="links blog-nav" aria-label="Site navigation">
    <a href="/">Home</a>
    <a href="/blog/" aria-current="page">Blog</a>
  </nav>
  <h1>Blog</h1>
  {posts.length ? (
    <ul class="post-list" role="list">
      {posts.map(({ id, data }) => (
        <li>
          <h2><a href={`/blog/${id}/`}>{data.title}</a></h2>
          <time datetime={data.date}>{formatPostDate(data.date)}</time>
          {data.description && <p>{data.description}</p>}
        </li>
      ))}
    </ul>
  ) : (
    <p class="blog-empty">No posts here yet. You can find my <a href="/#writing-and-talks">writing and talks</a> on the homepage.</p>
  )}

  <section class="writing-elsewhere" aria-labelledby="elsewhere">
    <h2 id="elsewhere">Elsewhere</h2>
    <ul class="post-list" role="list">
      <li>
        <h3><a href="https://roundup.getdbt.com/p/the-iceberg-ecosystem-today-anders">The Iceberg ecosystem today</a></h3>
        <p>A Roundup podcast conversation with Tristan Handy about what works in production and where Iceberg catalogs still get tricky.</p>
      </li>
      <li>
        <h3><a href="https://github.com/dbt-labs/dbt/discussions/15181">Fusion Diaries</a></h3>
        <p>Community updates on Fusion’s progress, rough edges, and next steps. Also see the <a href="https://github.com/dbt-labs/dbt/discussions/15187">Coalesce edition</a>.</p>
      </li>
      <li>
        <h3><a href="https://github.com/dbt-labs/dbt/discussions/11265">Proposal: External tables in dbt Core</a></h3>
        <p>A discussion about letting dbt create and manage external tables declared in a project.</p>
      </li>
    </ul>
  </section>
</SiteLayout>

<style>
  .writing-elsewhere {
    margin-top: 2rem;
  }

  .writing-elsewhere h3 {
    margin: 0;
  }
</style>
