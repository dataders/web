---
import { render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { formatPostDate, getPublishedPosts } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { title, description, date } = post.data;
const { Content } = await render(post);
---

<SiteLayout title={`${title} · Anders Swanson`} description={description ?? title}>
  <nav class="links blog-nav" aria-label="Site navigation">
    <a href="/">Home</a>
    <a href="/blog/">Blog</a>
  </nav>
  <article>
    <h1>{title}</h1>
    <time datetime={date}>{formatPostDate(date)}</time>
    <div class="post-content">
      <Content />
    </div>
  </article>
</SiteLayout>
