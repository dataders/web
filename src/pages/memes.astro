---
import ImageGallery from '../components/ImageGallery.astro';
import SiteLayout from '../layouts/SiteLayout.astro';

const images = [
  {
    src: '/memes/images/identifier-case.png',
    width: 889,
    height: 500,
    alt: 'A couple lies awake. She thinks he is thinking about a woman from the bakery. He is losing his mind over whether DuckDB, MDLS, Snowflake, Horizon, and Polaris treat foo and FOO as the same identifier.',
  },
  {
    src: '/memes/images/csv-parser.png',
    width: 748,
    height: 974,
    alt: 'A wide-eyed dog illustrates the warning that if you gaze long into a CSV parser, the CSV parser gazes also into you.',
  },
  {
    src: '/memes/images/schema-iceberg.png',
    width: 500,
    height: 759,
    alt: 'Schema, data’s most overloaded term, as an iceberg. Database schema is at the tip. Below the water are star schema, schema evolution, JSON Schema, and eventually Ponzi schema.',
  },
  {
    src: '/memes/images/data-mesh-demon.png',
    width: 500,
    height: 500,
    alt: 'Sleep paralysis, but the demon keeps asking if things are data meshes. It asks a sleeping woman if a folder of Excel files is a data mesh.',
  },
  {
    src: '/memes/images/pyramid-of-data-pyramids-preview.webp',
    fullSrc: '/memes/images/pyramid-of-data-pyramids.webp',
    width: 1600,
    height: 1269,
    alt: 'Dataders’s hypermodern pyramid of data pyramids. Expanding brains and overlapping pyramids rank industry recognition from LinkedIn replies through retweets, engineering blogs, HBR, and finally being sued by Amway and Mary Kay.',
  },
];
---

<SiteLayout title="Memes · Anders Swanson" description="Data memes collected by Anders Swanson.">
  <header class="memes-header">
    <a href="/">Home</a>
    <h1>Memes</h1>
  </header>
  <ImageGallery images={images} label="Memes" />
</SiteLayout>

<style>
  .memes-header {
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }

  .memes-header h1 {
    margin-top: 0.5rem;
  }
</style>
